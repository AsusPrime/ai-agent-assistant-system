# === LLM ===
LLM_PROVIDER=gemini          # gemini | openai | ollama
API_KEY=                      # API key (from aistudio.google.com for Gemini)
MODEL_NAME=gemini-2.0-flash   # model name
LLM_BASE_URL=http://localhost:11434/v1  # only for ollama

# === General ===
DEBUG=false
DATA_DIR=~/.my_data
MEMORY_TURNS=8

# === API Server ===
API_HOST=127.0.0.1
API_PORT=8000
API_AUTO_APPROVE=false        # auto-approve tasks on server side (CLI mode)

# === ReAct ===
REACT_MAX_ITERATIONS=50
PLANNER_MAX_RETRIES=3

# === Web / HTTP ===
WEB_TIMEOUT=10.0
HTTP_TIMEOUT=15.0
WEB_MAX_RESULTS=5
WEB_MAX_TEXT_LEN=8000
HTTP_MAX_BODY_LEN=8000

# === MCP ===
MCP_CONFIG_PATH=~/.akashi/mcp_servers.json
MCP_CALL_TIMEOUT=30.0
MCP_DESC_MAX_LEN=500
MCP_ERROR_BODY_MAX=800

# === Knowledge Base ===
KB_MAX_FILE_BYTES=524288
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50

# === UI ===
UI_TAMAGOTCHI=true            # show/hide tamagotchi character
UI_AUTO_APPROVE=false         # auto-approve tasks in GUI (skip approve/deny buttons)
UI_MAX_VISIBLE_TASKS=5        # max task cards visible at once
UI_SUMMARY_DELAY_MS=1500      # delay before showing summary after last task
UI_LANGUAGE=uk                # ui language (uk | en)
